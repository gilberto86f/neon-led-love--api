generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           Int              @id @default(autoincrement())
  name         String
  description  String
  slug         String           @unique
  discountType String?
  discount     Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  categories   Category[]
  variants     ProductVariant[]
}

model ProductVariant {
  id        Int      @id @default(autoincrement())
  price     Float
  width     Float
  height    Float
  sizeUnit  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  images      String[]
  slug        String    @unique
  description String
  tags        String[]
  isActive    Boolean   @default(true)
  notes       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}
