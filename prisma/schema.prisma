generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id           Int              @id @default(autoincrement())
  name         String
  description  String
  slug         String           @unique
  images       String[]
  isActive     Boolean          @default(true)
  discountType String?
  discount     Int?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  categories   Category[]
  variants     ProductVariant[]
  colorOptions ProductColorOption[]
  tags         Tag[]
}

model ProductVariant {
  id        Int      @id @default(autoincrement())
  price     Float
  width     Float
  height    Float
  sizeUnit  String
  stock     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductColorOption {
  id           Int      @id @default(autoincrement())
  description  String
  colors       Json
  defaultColor Json
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  productId    Int
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model CustomPrices {
  id                            Int      @id @default(1)
  acrylicAreaMultiplier         Float    @default(0)
  acrylicCostPerSquareFoot      Float    @default(0)
  backboardColorPriceBlack      Float    @default(0)
  backboardColorPriceClear      Float    @default(0)
  backboardColorPriceGold       Float    @default(0)
  backboardColorPriceSilver     Float    @default(0)
  backboardColorPriceWhite      Float    @default(0)
  backboardStyleBox             Float    @default(0)
  backboardStyleBoxMin          Float    @default(0)
  backboardStyleCutAround       Float    @default(0)
  backboardStyleCutAroundMin    Float    @default(0)
  backboardStyleInvisible       Float    @default(0)
  backboardStyleInvisibleMin    Float    @default(0)
  backboardStyleRectangular     Float    @default(0)
  backboardStyleRectangularMin  Float    @default(0)
  backboardStyleStand           Float    @default(0)
  backboardStyleStandMin        Float    @default(0)
  backboardStyleStroke          Float    @default(0)
  backboardStyleStrokeMin       Float    @default(0)
  dynamicSmartLed               Float    @default(0)
  eliminator                    Float    @default(0)
  fontComplexityMultiplier      Float    @default(0)
  fontStyleMultiplier           Float    @default(0)
  lowerCaseCharacters           Float    @default(0)
  mockUp                        Float    @default(0)
  remoteControlPrice            Float    @default(0)
  signMountingKitPrice          Float    @default(0)
  specialCharacters             Float    @default(0)
  upperCaseCharacters           Float    @default(0)
  wallMountingKitBlack          Float    @default(0)
  wallMountingKitGold           Float    @default(0)
  wallMountingKitSilver         Float    @default(0)
  waterproof                    Float    @default(0)
  waterproofMin                 Float    @default(0)
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  images      String[]
  slug        String    @unique
  description String
  tags        String[]
  isActive    Boolean   @default(true)
  notes       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model User {
  id                      Int       @id @default(autoincrement())
  fullName                String
  email                   String    @unique
  phoneNumber             String?   @db.VarChar(20)
  role                    String
  status                  Int       @default(1)
  notificationPreferences Int?
  dateOfBirth             String?
  passwordHash            String?
  isVerified              Boolean   @default(false)
  verificationToken       String?   @unique
  refreshTokenHash        String?
  refreshTokenExpiresAt   DateTime?
  isGuest                 Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  orders                  Order[]
  quotes                  Quote[]
}

// A purchase made by a user. `status` is the numeric OrderStatus enum
// (0 = PENDING_PAYMENT … 10 = REFUNDED) and acts as the *current-state
// projection*: it exists so listing and filtering orders never has to load the
// audit trail. `statusHistory` is the source of truth for how the order got
// there. The two are only ever written together, inside a transaction — see
// `applyStatusChange` in src/services/order.service.ts.
model Order {
  id              Int                  @id @default(autoincrement())
  userId          Int
  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  status          Int                  @default(0)
  currency        String
  subtotalAmount  Float
  shippingAmount  Float
  taxAmount       Float
  totalAmount     Float
  shippingAddress Json?
  paymentId       String?
  trackingNumber  String?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
}

// Immutable audit trail of order status transitions. One row per change,
// including the order's creation (`previousStatus = null`). Rows are never
// updated or deleted by the application; they disappear only with the order.
// `changedByUser` holds the acting user's id as text, or one of the
// non-user actors "system" / "Stripe Webhook".
model OrderStatusHistory {
  id             Int      @id @default(autoincrement())
  orderId        Int
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus Int?
  newStatus      Int
  changedByUser  String
  comment        String?
  createdAt      DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([createdAt])
}

model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       Int
  productName     String
  productSlug     String
  productImageUrl String?
  unitPrice       Float
  quantity        Int
  totalAmount     Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Slide {
  id             Int      @id @default(autoincrement())
  isActive       Boolean  @default(true)
  position       Int      @unique
  imageUrl       String?
  styleClass     String?
  title          String?
  description    String?
  buttonLabel    String?
  route          String?
  innerHtml      String?
  justifyContent String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// A custom-neon quote request. Guests and clients submit the request half
// (CustomQuoteRequestData); staff later fill in the pricing/quote half.
// Nested configuration (neonTexts, size) is stored as JSON; string collections
// (images, mockUpQuote) as text arrays. `status` is the numeric QuoteStatus
// enum (0 = DRAFT … 9 = EXPIRED); new requests default to 1 = SUBMITTED.
model Quote {
  id           Int      @id @default(autoincrement())
  status       Int      @default(1)
  price        Float    @default(0)

  // Requester (optional — guests may submit without an account).
  clientId     Int?
  client       User?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  fullName     String
  email        String
  phoneNumber  String
  isCustom     Boolean  @default(false)

  // Custom-neon configuration (from CustomQuoteRequestData / CustomNeon).
  neonTexts       Json?
  alignment       String?
  size            Json?
  notes           String?
  waterproof      Boolean?
  backboardStyle  String?
  backboardColor  String?
  wallMountingKit String?
  signMountingKit Boolean?
  remoteControl   Boolean?
  width           Float?
  height          Float?
  images          String[]
  sizeUnit        String?

  // Staff-filled quote/pricing half (empty until the team prices the request).
  descriptionQuote             String?
  descriptionPrice             Float?
  descriptionSuggestedPrice    Float?
  widthQuote                   Float?
  heightQuote                  Float?
  sizePrice                    Float?
  sizeSuggestedPrice           Float?
  waterproofQuote              Boolean?
  waterproofPrice              Float?
  waterproofSuggestedPrice     Float?
  backboardStyleQuote          String?
  backboardStylePrice          Float?
  backboardStyleSuggestedPrice Float?
  backboardColorQuote          String?
  backboardColorPrice          Float?
  backboardColorSuggestedPrice Float?
  mockUpQuote                  String[]
  mockUpPrice                  Float?
  mockUpSuggestedPrice         Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
