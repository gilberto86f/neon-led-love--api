DATABASE_URL="postgresql://nll:nll@localhost:5432/neon_led_love?schema=public"
PORT=3000

# --- JWT Authentication ---
# Change these in production. Use long, random strings (e.g. `openssl rand -hex 64`).
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
# Access token lifetime (zeit/ms string: "30m", "1h", "15m", etc.)
JWT_ACCESS_EXPIRES_IN="30m"
# Refresh token lifetime (zeit/ms string).
JWT_REFRESH_EXPIRES_IN="30d"
# Refresh token DB expiry in days. Should match JWT_REFRESH_EXPIRES_IN.
JWT_REFRESH_TTL_DAYS=30
# bcrypt cost factor. 10 is a sensible default.
BCRYPT_SALT_ROUNDS=10
