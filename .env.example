DATABASE_URL="postgresql://nll:nll@localhost:5432/neon_led_love?schema=public"
PORT=3000

# --- JWT Authentication ---
# Change these in production. Use long, random strings (e.g. `openssl rand -hex 64`).
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
# Access token lifetime (zeit/ms string: "30m", "1h", "15m", etc.)
JWT_ACCESS_EXPIRES_IN="30m"
# Refresh token lifetime (zeit/ms string).
JWT_REFRESH_EXPIRES_IN="30d"
# Refresh token DB expiry in days. Should match JWT_REFRESH_EXPIRES_IN.
JWT_REFRESH_TTL_DAYS=30
# bcrypt cost factor. 10 is a sensible default.
BCRYPT_SALT_ROUNDS=10

# --- Stripe payments ---
# Secret API key from https://dashboard.stripe.com/test/apikeys ("Secret key").
# SERVER-SIDE ONLY — never ship this to Angular; the frontend uses the
# *publishable* key (pk_test_...), which lives in the frontend's own env.
STRIPE_SECRET_KEY="sk_test_change_me"
# Signing secret for the webhook endpoint. In local development this is printed
# by `stripe listen --forward-to localhost:3000/api/payments/webhook/stripe`;
# in production it comes from the endpoint's page in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET="whsec_change_me"
# ISO 4217 code sent to Stripe, lowercase. The store sells in Mexican pesos.
STRIPE_CURRENCY="mxn"
